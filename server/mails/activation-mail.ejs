<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>NGECP Activation Email</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: &quot;Segoe UI&quot;, Arial, Helvetica, sans-serif;
      background-color: #f0fdf4;
      color: #1e293b;
    "
  >
    <!-- Outer Wrapper Table -->
    <table
      role="presentation"
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f0fdf4; table-layout: fixed"
    >
      <tr>
        <td align="center" style="padding: 40px 10px">
          <!-- Main Email Container -->
          <table
            role="presentation"
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 12px;
              box-shadow: 0 4px 16px rgba(5, 150, 105, 0.08);
              overflow: hidden;
              border: 1px solid #d1fae5;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background: #059669;
                  background: linear-gradient(135deg, #059669, #047857);
                  color: #ffffff;
                  padding: 36px 20px;
                "
              >
                <h1
                  style="
                    margin: 0;
                    font-size: 24px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    color: #ffffff;
                  "
                >
                  Welcome to NGECP
                </h1>
              </td>
            </tr>

            <!-- Body Content -->
            <tr>
              <td style="padding: 36px 30px">
                <p
                  style="
                    font-size: 16px;
                    line-height: 1.6;
                    color: #0f172a;
                    margin: 0 0 16px 0;
                  "
                >
                  Hello <strong><%= user.name %></strong>,
                </p>
                <p
                  style="
                    font-size: 15px;
                    line-height: 1.6;
                    color: #334155;
                    margin: 0 0 24px 0;
                  "
                >
                  Thank you for registering with the
                  <strong style="color: #065f46"
                    >National Generator Emission Control Program (NGECP)</strong
                  >. Please activate your account by clicking the button below
                  within the next <strong>5 minutes</strong>:
                </p>

                <!-- Call to Action Button (Bulletproof table syntax for Outlook) -->
                <table
                  role="presentation"
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="100%"
                >
                  <tr>
                    <td align="center" style="padding: 10px 0 24px 0">
                      <table
                        role="presentation"
                        border="0"
                        cellpadding="0"
                        cellspacing="0"
                      >
                        <tr>
                          <td
                            align="center"
                            bgcolor="#059669"
                            style="border-radius: 8px"
                          >
                            <a
                              href="<%= activationUrl %>"
                              target="_blank"
                              style="
                                font-size: 15px;
                                font-weight: 600;
                                color: #ffffff;
                                text-decoration: none;
                                padding: 14px 28px;
                                border-radius: 8px;
                                border: 1px solid #059669;
                                display: inline-block;
                                background-color: #059669;
                              "
                            >
                              Activate Account
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    font-size: 14px;
                    line-height: 1.5;
                    color: #64748b;
                    margin: 16px 0 0 0;
                  "
                >
                  If you did not register for an NGECP account, please feel free
                  to ignore this email.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background-color: #f8fafc;
                  padding: 24px 20px;
                  border-top: 1px solid #e2e8f0;
                "
              >
                <p style="font-size: 13px; color: #64748b; margin: 0 0 8px 0">
                  Need help? Contact our support team at
                  <a
                    href="mailto:support@ngecp.com"
                    style="
                      color: #059669;
                      font-weight: 500;
                      text-decoration: none;
                    "
                    >support@ngecp.com</a
                  >
                </p>
                <p style="font-size: 12px; color: #94a3b8; margin: 0">
                  &copy; <%= new Date().getFullYear() %> NGECP. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
